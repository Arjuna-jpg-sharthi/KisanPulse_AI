# Copy this file to .env and paste your Gemini API key after the equals sign.
# Keep .env private; it is ignored by Git.
GEMINI_API_KEY=replace_with_your_gemini_api_key

# Optional: only needed if using the scheme publishing/admin form.
# ADMIN_API_KEY=choose_a_private_admin_password

# Optional: data.gov.in key enables official mandi prices in the Smart Mandi page.
# DATA_GOV_IN_API_KEY=your_data_gov_in_api_key

# OpenWeather API key for current conditions, 5-day forecast, and Indian city/district search.
OPENWEATHER_API_KEY=your_openweather_api_key
